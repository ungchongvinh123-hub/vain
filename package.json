{
  "name": "vain",
  "version": "1.0.0",
  "private": true,
  "description": "VAIN \u2014 Gacha Turn-Based RPG 2D (offline-first, landscape 16:9, Capacitor-ready)",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "android:sync": "npm run build:apk-web && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "cd android && ./gradlew assembleRelease",
    "icons": "node scripts/make-icons.mjs",
    "build:web": "next build",
    "build:apk-web": "node scripts/build-apk.mjs",
    "android:add": "npm run build:apk-web && npx cap add android && npx cap sync android",
    "android:apk:debug": "cd android && ./gradlew assembleDebug",
    "sprites": "tsx scripts/generate-sprites.ts",
    "test:sim": "tsx scripts/test-battle.ts"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/share": "^6.0.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "drizzle-orm": "^0.38.3",
    "framer-motion": "^11.15.0",
    "next": "^15.1.4",
    "pg": "^8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sonner": "^1.7.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
